diff --git a/Firmware/main/board_display.c b/Firmware/main/board_display.c
index e55bb1a..4e11614 100644
--- a/Firmware/main/board_display.c
+++ b/Firmware/main/board_display.c
@@ -8,6 +8,7 @@
 #include "esp_lcd_panel_io.h"
 #include "esp_lcd_io_spi.h"
 #include "esp_lcd_panel_st7789.h"
+#include "esp_timer.h"
 #include "esp_log.h"
 #include "freertos/FreeRTOS.h"
 #include "freertos/semphr.h"
@@ -22,12 +23,31 @@ static const char *TAG = "board_display";
 static esp_lcd_panel_handle_t s_panel;
 static esp_lcd_panel_io_handle_t s_io;
 static SemaphoreHandle_t s_transfer_done;
+static portMUX_TYPE s_perf_lock = portMUX_INITIALIZER_UNLOCKED;
+static board_display_perf_snapshot_t s_perf;
+static int64_t s_perf_started_us;
+static uint32_t s_perf_pending_pixels;
+static bool s_perf_pending;
+
 
 static bool on_color_transfer_done(esp_lcd_panel_io_handle_t panel_io, esp_lcd_panel_io_event_data_t *event_data, void *user_context)
 {
     (void)panel_io;
     (void)event_data;
     (void)user_context;
+    const int64_t completed_us = esp_timer_get_time();
+    portENTER_CRITICAL_ISR(&s_perf_lock);
+    if (s_perf_pending) {
+        const uint32_t duration_us = (uint32_t)(completed_us - s_perf_started_us);
+        s_perf.transfers++;
+        s_perf.pixels += s_perf_pending_pixels;
+        s_perf.transfer_total_us += duration_us;
+        if (duration_us > s_perf.transfer_max_us) {
+            s_perf.transfer_max_us = duration_us;
+        }
+        s_perf_pending = false;
+    }
+    portEXIT_CRITICAL_ISR(&s_perf_lock);
     BaseType_t high_priority_woken = pdFALSE;
     xSemaphoreGiveFromISR(s_transfer_done, &high_priority_woken);
     return high_priority_woken == pdTRUE;
@@ -117,6 +137,65 @@ void board_display_wait_for_transfer(void)
     (void)xSemaphoreTake(s_transfer_done, pdMS_TO_TICKS(1000));
 }
 
+void board_display_perf_begin_transfer(uint32_t pixels)
+{
+    portENTER_CRITICAL(&s_perf_lock);
+    if (s_perf_pending) {
+        s_perf.overlaps++;
+    }
+    s_perf_started_us = esp_timer_get_time();
+    s_perf_pending_pixels = pixels;
+    s_perf_pending = true;
+    portEXIT_CRITICAL(&s_perf_lock);
+}
+
+void board_display_perf_cancel_transfer(void)
+{
+    portENTER_CRITICAL(&s_perf_lock);
+    s_perf_pending = false;
+    portEXIT_CRITICAL(&s_perf_lock);
+}
+
+bool board_display_perf_wait_idle(void)
+{
+    const int64_t deadline_us = esp_timer_get_time() + 1000000LL;
+    while (true) {
+        portENTER_CRITICAL(&s_perf_lock);
+        const bool pending = s_perf_pending;
+        portEXIT_CRITICAL(&s_perf_lock);
+        if (!pending) {
+            return true;
+        }
+        if (esp_timer_get_time() >= deadline_us) {
+            return false;
+        }
+        vTaskDelay(1);
+    }
+}
+
+bool board_display_perf_reset(void)
+{
+    if (!board_display_perf_wait_idle()) {
+        return false;
+    }
+    portENTER_CRITICAL(&s_perf_lock);
+    s_perf = (board_display_perf_snapshot_t){0};
+    s_perf_started_us = 0;
+    s_perf_pending_pixels = 0;
+    portEXIT_CRITICAL(&s_perf_lock);
+    return true;
+}
+
+void board_display_perf_snapshot(board_display_perf_snapshot_t *out_snapshot)
+{
+    if (out_snapshot == NULL) {
+        return;
+    }
+    portENTER_CRITICAL(&s_perf_lock);
+    *out_snapshot = s_perf;
+    portEXIT_CRITICAL(&s_perf_lock);
+}
+
 esp_lcd_panel_handle_t board_display_panel(void)
 {
     return s_panel;
